[
    {
        "description": "A name pattern matches at any depth",
        "ignoreFile": "*.log\n",
        "paths": [
            {
                "path": "a.log",
                "result": "ignored"
            },
            {
                "path": "dir/a.log",
                "result": "ignored"
            },
            {
                "path": "dir/sub/a.log",
                "result": "ignored"
            },
            {
                "path": "a.txt",
                "result": "none"
            },
            {
                "path": "a.log.txt",
                "result": "none"
            }
        ]
    },
    {
        "description": "Matching ignores case",
        "ignoreFile": "*.log\nBuild/\n",
        "paths": [
            {
                "path": "a.LOG",
                "result": "ignored"
            },
            {
                "path": "A.Log",
                "result": "ignored"
            },
            {
                "path": "build/x.js",
                "result": "ignored"
            },
            {
                "path": "BUILD/x.js",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A leading slash anchors the pattern to the ignore file's folder",
        "ignoreFile": "/build\n",
        "paths": [
            {
                "path": "build",
                "result": "ignored"
            },
            {
                "path": "build/x.js",
                "result": "ignored"
            },
            {
                "path": "src/build",
                "result": "none"
            },
            {
                "path": "src/build/x.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "A trailing slash matches only folders",
        "ignoreFile": "build/\n",
        "paths": [
            {
                "path": "build",
                "result": "none"
            },
            {
                "path": "build/x.js",
                "result": "ignored"
            },
            {
                "path": "src/build/x.js",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A slash in the middle anchors the pattern",
        "ignoreFile": "doc/frotz\n",
        "paths": [
            {
                "path": "doc/frotz",
                "result": "ignored"
            },
            {
                "path": "doc/frotz/x.js",
                "result": "ignored"
            },
            {
                "path": "a/doc/frotz",
                "result": "none"
            }
        ]
    },
    {
        "description": "A negation unignores a file",
        "ignoreFile": "*.log\n!keep.log\n",
        "paths": [
            {
                "path": "a.log",
                "result": "ignored"
            },
            {
                "path": "keep.log",
                "result": "unignored"
            },
            {
                "path": "dir/keep.log",
                "result": "unignored"
            }
        ]
    },
    {
        "description": "A negation can't unignore a file in an ignored folder",
        "ignoreFile": "logs/\n!logs/keep.log\n",
        "paths": [
            {
                "path": "logs/a.log",
                "result": "ignored"
            },
            {
                "path": "logs/keep.log",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A negation after a folder's contents are ignored does unignore",
        "ignoreFile": "logs/*\n!logs/keep.log\n",
        "paths": [
            {
                "path": "logs/a.log",
                "result": "ignored"
            },
            {
                "path": "logs/keep.log",
                "result": "unignored"
            }
        ]
    },
    {
        "description": "A later pattern overrides an earlier one",
        "ignoreFile": "!a.log\n*.log\n",
        "paths": [
            {
                "path": "a.log",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A negation with nothing to override is still an opinion",
        "ignoreFile": "!a.js\n",
        "paths": [
            {
                "path": "a.js",
                "result": "unignored"
            },
            {
                "path": "b.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "A leading **/ matches in any folder",
        "ignoreFile": "**/foo\n",
        "paths": [
            {
                "path": "foo",
                "result": "ignored"
            },
            {
                "path": "a/foo",
                "result": "ignored"
            },
            {
                "path": "a/b/foo/x.js",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A trailing /** matches everything inside",
        "ignoreFile": "foo/**\n",
        "paths": [
            {
                "path": "foo",
                "result": "none"
            },
            {
                "path": "foo/x.js",
                "result": "ignored"
            },
            {
                "path": "foo/a/b.js",
                "result": "ignored"
            },
            {
                "path": "a/foo/x.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "/**/ matches zero or more folders",
        "ignoreFile": "a/**/b\n",
        "paths": [
            {
                "path": "a/b",
                "result": "ignored"
            },
            {
                "path": "a/x/b",
                "result": "ignored"
            },
            {
                "path": "a/x/y/b",
                "result": "ignored"
            },
            {
                "path": "x/a/b",
                "result": "none"
            }
        ]
    },
    {
        "description": "* doesn't cross folders",
        "ignoreFile": "a/*.js\n",
        "paths": [
            {
                "path": "a/x.js",
                "result": "ignored"
            },
            {
                "path": "a/b/x.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "? matches one character",
        "ignoreFile": "file?.js\n",
        "paths": [
            {
                "path": "file1.js",
                "result": "ignored"
            },
            {
                "path": "file.js",
                "result": "none"
            },
            {
                "path": "file12.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "A character class matches one of its characters",
        "ignoreFile": "file[0-9].js\n[!a]x.js\n",
        "paths": [
            {
                "path": "file5.js",
                "result": "ignored"
            },
            {
                "path": "filex.js",
                "result": "none"
            },
            {
                "path": "bx.js",
                "result": "ignored"
            },
            {
                "path": "ax.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "Comments and blank lines are skipped",
        "ignoreFile": "# *.js\n\n   \n*.log\n",
        "paths": [
            {
                "path": "a.js",
                "result": "none"
            },
            {
                "path": "a.log",
                "result": "ignored"
            },
            {
                "path": "# *.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "A backslash escapes a leading # or !",
        "ignoreFile": "\\#hash\n\\!bang\n",
        "paths": [
            {
                "path": "#hash",
                "result": "ignored"
            },
            {
                "path": "!bang",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "Trailing spaces are dropped unless escaped",
        "ignoreFile": "a.js   \nb\\ \n",
        "paths": [
            {
                "path": "a.js",
                "result": "ignored"
            },
            {
                "path": "b ",
                "result": "ignored"
            },
            {
                "path": "b",
                "result": "none"
            }
        ]
    },
    {
        "description": "A lone * matches everything",
        "ignoreFile": "*\n",
        "paths": [
            {
                "path": "a.js",
                "result": "ignored"
            },
            {
                "path": "dir/a.js",
                "result": "ignored"
            },
            {
                "path": ".hidden",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "Dotfiles match like any other file",
        "ignoreFile": ".*\n",
        "paths": [
            {
                "path": ".env",
                "result": "ignored"
            },
            {
                "path": "dir/.env",
                "result": "ignored"
            },
            {
                "path": "a.js",
                "result": "none"
            }
        ]
    },
    {
        "description": "CRLF line endings are allowed",
        "ignoreFile": "*.log\r\n!keep.log\r\n",
        "paths": [
            {
                "path": "a.log",
                "result": "ignored"
            },
            {
                "path": "keep.log",
                "result": "unignored"
            }
        ]
    },
    {
        "description": "A file outside the ignore file's folder gets no opinion",
        "ignoreFile": "*\n",
        "paths": [
            {
                "path": "../outside.log",
                "result": "none"
            },
            {
                "path": "inside.log",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "An ignore file has no opinion on a sibling folder whose name starts with its own folder's name",
        "folder": "a",
        "ignoreFile": "*.log\n",
        "paths": [
            {
                "path": "x.log",
                "result": "ignored"
            },
            {
                "path": "../ab/x.log",
                "result": "none"
            },
            {
                "path": "../x.log",
                "result": "none"
            }
        ]
    },
    {
        "description": "A byte order mark at the start of the file isn't part of the first pattern",
        "ignoreFile": "\ufeffa.log\n",
        "paths": [
            {
                "path": "a.log",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A pattern with an unclosed bracket matches nothing",
        "ignoreFile": "[\nfoo[ab\n",
        "paths": [
            {
                "path": "[",
                "result": "none"
            },
            {
                "path": "foo[ab",
                "result": "none"
            }
        ]
    },
    {
        "description": "A line that is only an exclamation mark matches nothing",
        "ignoreFile": "*.js\n!\n",
        "paths": [
            {
                "path": "x.js",
                "result": "ignored"
            },
            {
                "path": "x.txt",
                "result": "none"
            }
        ]
    },
    {
        "description": "Braces match themselves rather than a choice of names",
        "ignoreFile": "{a,b}\n",
        "paths": [
            {
                "path": "a",
                "result": "none"
            },
            {
                "path": "b",
                "result": "none"
            },
            {
                "path": "{a,b}",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A POSIX character class matches its characters",
        "ignoreFile": "[[:alpha:]]\n",
        "paths": [
            {
                "path": "q",
                "result": "ignored"
            },
            {
                "path": "1",
                "result": "none"
            }
        ]
    },
    {
        "description": "The JavaScript ignores case for letters beyond ASCII, which git doesn't",
        "ignoreFile": "É.txt\n",
        "paths": [
            {
                "path": "é.txt",
                "result": "ignored",
                "rust": {
                    "result": "none",
                    "reason": "The Rust implementation ignores case only for ASCII letters, as git does."
                }
            },
            {
                "path": "É.txt",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A backslash in a bracket class escapes the next character",
        "ignoreFile": "[\\]]\n[a\\-z]\n",
        "paths": [
            {
                "path": "]",
                "result": "ignored"
            },
            {
                "path": "-",
                "result": "ignored"
            },
            {
                "path": "b",
                "result": "none"
            }
        ]
    },
    {
        "description": "Braces in a bracket class are ordinary characters",
        "ignoreFile": "[{}]\n",
        "paths": [
            {
                "path": "{",
                "result": "ignored"
            },
            {
                "path": "}",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A brace can end a bracket class range",
        "ignoreFile": "[a-{]\n",
        "paths": [
            {
                "path": "b",
                "result": "ignored"
            },
            {
                "path": "{",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A dash after a range in a bracket class is an ordinary character",
        "ignoreFile": "[a-c-e]\n",
        "paths": [
            {
                "path": "-",
                "result": "ignored"
            },
            {
                "path": "d",
                "result": "none"
            },
            {
                "path": "e",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "A slash in a bracket class doesn't match a folder separator",
        "ignoreFile": "a[/]b\n",
        "paths": [
            {
                "path": "a/b",
                "result": "none"
            }
        ]
    },
    {
        "description": "Three or more asterisks between slashes act as two",
        "ignoreFile": "a/***/b\n",
        "paths": [
            {
                "path": "a/b",
                "result": "ignored"
            },
            {
                "path": "a/x/y/b",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "Only trailing spaces are stripped, not tabs",
        "ignoreFile": "foo\t\n",
        "paths": [
            {
                "path": "foo",
                "result": "none"
            },
            {
                "path": "foo\t",
                "result": "ignored"
            }
        ]
    },
    {
        "description": "An escaped trailing space is kept",
        "ignoreFile": "foo\\  \n",
        "paths": [
            {
                "path": "foo ",
                "result": "ignored"
            },
            {
                "path": "foo",
                "result": "none"
            }
        ]
    },
    {
        "description": "Two asterisks joined to other characters match within one folder name",
        "ignoreFile": "a**/b\n",
        "paths": [
            {
                "path": "ax/b",
                "result": "ignored"
            },
            {
                "path": "a/x/b",
                "result": "none"
            }
        ]
    },
    {
        "description": "An empty ignore file has no opinion",
        "ignoreFile": "",
        "paths": [
            {
                "path": "a.js",
                "result": "none"
            },
            {
                "path": "dir/a.js",
                "result": "none"
            }
        ]
    }
]
