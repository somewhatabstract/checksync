{
    "description": "Brace expansion and dotfile cases for checksync's Rust glob module. Unlike glob-vectors.json, the expected values come from the micromatch build that fast-glob uses, not from git or checksync's TypeScript. A `rust` entry records a deliberate difference, with the reason.",
    "expansions": [
        {
            "description": "A comma list stands for each alternative in turn",
            "cases": [
                {
                    "pattern": "a{b,c}d",
                    "expanded": [
                        "abd",
                        "acd"
                    ]
                },
                {
                    "pattern": "{a,b,c}",
                    "expanded": [
                        "a",
                        "b",
                        "c"
                    ]
                },
                {
                    "pattern": "x{a,bc,def}y",
                    "expanded": [
                        "xay",
                        "xbcy",
                        "xdefy"
                    ]
                },
                {
                    "pattern": "{a,b}/c",
                    "expanded": [
                        "a/c",
                        "b/c"
                    ]
                },
                {
                    "pattern": "a/{b,c}/d",
                    "expanded": [
                        "a/b/d",
                        "a/c/d"
                    ]
                }
            ]
        },
        {
            "description": "Empty alternatives are kept, as are duplicates",
            "cases": [
                {
                    "pattern": "a{,b}c",
                    "expanded": [
                        "ac",
                        "abc"
                    ]
                },
                {
                    "pattern": "{a,}",
                    "expanded": [
                        "a",
                        ""
                    ]
                },
                {
                    "pattern": "{,}",
                    "expanded": [
                        "",
                        ""
                    ]
                },
                {
                    "pattern": "{a,,b}",
                    "expanded": [
                        "a",
                        "",
                        "b"
                    ]
                },
                {
                    "pattern": "{a,a}",
                    "expanded": [
                        "a",
                        "a"
                    ]
                }
            ]
        },
        {
            "description": "Groups nest",
            "cases": [
                {
                    "pattern": "a{b,c{d,e}}f",
                    "expanded": [
                        "abf",
                        "acdf",
                        "acef"
                    ]
                },
                {
                    "pattern": "{a,{b,c}}",
                    "expanded": [
                        "a",
                        "b",
                        "c"
                    ]
                },
                {
                    "pattern": "{{a,b},c}",
                    "expanded": [
                        "a",
                        "b",
                        "c"
                    ]
                },
                {
                    "pattern": "{a,b{c,d}}",
                    "expanded": [
                        "a",
                        "bc",
                        "bd"
                    ]
                },
                {
                    "pattern": "{a,{b,c}d,e}",
                    "expanded": [
                        "a",
                        "bd",
                        "cd",
                        "e"
                    ]
                },
                {
                    "pattern": "{,{,}}",
                    "expanded": [
                        "",
                        "",
                        ""
                    ]
                }
            ]
        },
        {
            "description": "With several groups, the earlier one varies slowest",
            "cases": [
                {
                    "pattern": "{a,b}{c,d}",
                    "expanded": [
                        "ac",
                        "ad",
                        "bc",
                        "bd"
                    ]
                },
                {
                    "pattern": "{a,b}/{c,d}",
                    "expanded": [
                        "a/c",
                        "a/d",
                        "b/c",
                        "b/d"
                    ]
                },
                {
                    "pattern": "{a,b}{c,d}{e,f}",
                    "expanded": [
                        "ace",
                        "acf",
                        "ade",
                        "adf",
                        "bce",
                        "bcf",
                        "bde",
                        "bdf"
                    ]
                },
                {
                    "pattern": "x{a,b}y{c,d}z",
                    "expanded": [
                        "xaycz",
                        "xaydz",
                        "xbycz",
                        "xbydz"
                    ]
                }
            ]
        },
        {
            "description": "A brace group without a comma stays literal",
            "cases": [
                {
                    "pattern": "{a}",
                    "expanded": [
                        "{a}"
                    ]
                },
                {
                    "pattern": "{}",
                    "expanded": [
                        "{}"
                    ]
                },
                {
                    "pattern": "{a}{b,c}",
                    "expanded": [
                        "{a}b",
                        "{a}c"
                    ]
                },
                {
                    "pattern": "{{a,b}}",
                    "expanded": [
                        "{a}",
                        "{b}"
                    ]
                },
                {
                    "pattern": "{a{,}b}",
                    "expanded": [
                        "{ab}",
                        "{ab}"
                    ]
                },
                {
                    "pattern": "{a,{b}}",
                    "expanded": [
                        "a",
                        "{b}"
                    ]
                }
            ]
        },
        {
            "description": "An unclosed brace or a stray closing brace stays literal",
            "cases": [
                {
                    "pattern": "{a",
                    "expanded": [
                        "{a"
                    ]
                },
                {
                    "pattern": "a}",
                    "expanded": [
                        "a}"
                    ]
                },
                {
                    "pattern": "{a,b",
                    "expanded": [
                        "{a,b"
                    ]
                },
                {
                    "pattern": "a{b,c",
                    "expanded": [
                        "a{b,c"
                    ]
                },
                {
                    "pattern": "x{a{b,c}",
                    "expanded": [
                        "x{ab",
                        "x{ac"
                    ]
                },
                {
                    "pattern": "{a,b}c}",
                    "expanded": [
                        "ac}",
                        "bc}"
                    ]
                },
                {
                    "pattern": "}{a,b}{",
                    "expanded": [
                        "}a{",
                        "}b{"
                    ]
                },
                {
                    "pattern": "{a,b{c}",
                    "expanded": [
                        "{a,b{c}"
                    ]
                },
                {
                    "pattern": "{a,b}}",
                    "expanded": [
                        "a}",
                        "b}"
                    ]
                }
            ]
        },
        {
            "description": "Glob characters pass through expansion",
            "cases": [
                {
                    "pattern": "*{a,b}?",
                    "expanded": [
                        "*a?",
                        "*b?"
                    ]
                },
                {
                    "pattern": "{*,?}",
                    "expanded": [
                        "*",
                        "?"
                    ]
                },
                {
                    "pattern": "{a,b}/**",
                    "expanded": [
                        "a/**",
                        "b/**"
                    ]
                },
                {
                    "pattern": "**/{a,b}.js",
                    "expanded": [
                        "**/a.js",
                        "**/b.js"
                    ]
                },
                {
                    "pattern": "{a*,b?}",
                    "expanded": [
                        "a*",
                        "b?"
                    ]
                }
            ]
        },
        {
            "description": "Commas and braces inside brackets don't count",
            "cases": [
                {
                    "pattern": "{[a,b],c}",
                    "expanded": [
                        "[a,b]",
                        "c"
                    ]
                },
                {
                    "pattern": "{a,[b,c]}",
                    "expanded": [
                        "a",
                        "[b,c]"
                    ]
                },
                {
                    "pattern": "[{a,b}]",
                    "expanded": [
                        "[{a,b}]"
                    ]
                },
                {
                    "pattern": "x[a]{b,c}[d]",
                    "expanded": [
                        "x[a]b[d]",
                        "x[a]c[d]"
                    ]
                },
                {
                    "pattern": "{a,[}b,c]}",
                    "expanded": [
                        "a",
                        "[}b,c]"
                    ]
                },
                {
                    "pattern": "{a,[b,c}",
                    "expanded": [
                        "{a,[b,c}"
                    ]
                },
                {
                    "pattern": "{[a,b]}",
                    "expanded": [
                        "{[a,b]}"
                    ]
                },
                {
                    "pattern": "{a,[b[c,d]e]}",
                    "expanded": [
                        "a",
                        "[b[c,d]e]"
                    ]
                }
            ]
        },
        {
            "description": "A backslash escapes a brace or comma",
            "cases": [
                {
                    "pattern": "\\{a,b}",
                    "expanded": [
                        "{a,b}"
                    ],
                    "rust": {
                        "expanded": [
                            "\\{a,b}"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                },
                {
                    "pattern": "{a\\,b,c}",
                    "expanded": [
                        "a,b",
                        "c"
                    ],
                    "rust": {
                        "expanded": [
                            "a\\,b",
                            "c"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                },
                {
                    "pattern": "{a,b\\}",
                    "expanded": [
                        "{a,b}"
                    ],
                    "rust": {
                        "expanded": [
                            "{a,b\\}"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                },
                {
                    "pattern": "a\\{b,c\\}",
                    "expanded": [
                        "a{b,c}"
                    ],
                    "rust": {
                        "expanded": [
                            "a\\{b,c\\}"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                },
                {
                    "pattern": "{a\\}b,c}",
                    "expanded": [
                        "a}b",
                        "c"
                    ],
                    "rust": {
                        "expanded": [
                            "a\\}b",
                            "c"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                },
                {
                    "pattern": "{\\,}",
                    "expanded": [
                        "{,}"
                    ],
                    "rust": {
                        "expanded": [
                            "{\\,}"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                },
                {
                    "pattern": "{a,b}\\{c,d}",
                    "expanded": [
                        "a{c,d}",
                        "b{c,d}"
                    ],
                    "rust": {
                        "expanded": [
                            "a\\{c,d}",
                            "b\\{c,d}"
                        ],
                        "reason": "The results keep the pattern's escapes, so each is still a glob pattern; micromatch drops them."
                    }
                }
            ]
        },
        {
            "description": "Ranges aren't expanded",
            "cases": [
                {
                    "pattern": "{1..3}",
                    "expanded": [
                        "1",
                        "2",
                        "3"
                    ],
                    "rust": {
                        "expanded": [
                            "{1..3}"
                        ],
                        "reason": "Ranges aren't expanded, a deliberate difference."
                    }
                },
                {
                    "pattern": "{a..c}",
                    "expanded": [
                        "a",
                        "b",
                        "c"
                    ],
                    "rust": {
                        "expanded": [
                            "{a..c}"
                        ],
                        "reason": "Ranges aren't expanded, a deliberate difference."
                    }
                },
                {
                    "pattern": "x{1..2}y",
                    "expanded": [
                        "x1y",
                        "x2y"
                    ],
                    "rust": {
                        "expanded": [
                            "x{1..2}y"
                        ],
                        "reason": "Ranges aren't expanded, a deliberate difference."
                    }
                }
            ]
        }
    ]
}
